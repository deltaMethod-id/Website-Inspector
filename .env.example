# WIPAS - Website Inspector Password Authentication System
# Password required to unlock the Website Inspector console.
INSPECTOR_PASSWORD=change-me

# Secret used to sign the WIPAS session cookie (HTTP-only).
# Use a long, random string in production, e.g. `openssl rand -hex 32`.
SESSION_SECRET=replace-with-long-random-secret

# Public app name, shown in the UI.
NEXT_PUBLIC_APP_NAME=Website Inspector
